# =============================================================================
# lukato 1.0.0 — modelo de configuracao
#
#   cp .env.example .env   e preencha os segredos.
#
# O arquivo .env NUNCA deve ser versionado (ja esta no .gitignore).
# Em producao, injete estas variaveis via Kubernetes Secret / Vault /
# AWS Secrets Manager — nunca via arquivo dentro da imagem.
#
# Convencao: prefixo LUKATO_ e delimitador aninhado "__".
#   LUKATO_LLM__MODEL  ->  settings.llm.model
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
LUKATO_APP__NAME=lukato
LUKATO_APP__ENV=dev                       # dev | staging | prod
LUKATO_APP__DEBUG=true
LUKATO_APP__HOST=0.0.0.0
LUKATO_APP__PORT=8000
LUKATO_APP__ROOT_PATH=

# -----------------------------------------------------------------------------
# Banco de dados — PostgreSQL 16 + pgvector
# Em dev, se o Postgres nao responder e AUTO_FALLBACK=true, a aplicacao
# cai para SQLite automaticamente (busca vetorial passa a ser em memoria).
# -----------------------------------------------------------------------------
LUKATO_DB__URL=postgresql+asyncpg://lukato:lukato@localhost:5432/lukato
LUKATO_DB__FALLBACK_URL=sqlite+aiosqlite:///./lukato.db
LUKATO_DB__AUTO_FALLBACK=true
LUKATO_DB__CREATE_ALL=true
LUKATO_DB__ECHO=false
LUKATO_DB__POOL_SIZE=10
LUKATO_DB__MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# LLM — hub GPU corporativo, API compativel com OpenAI
# Modelos liberados para a virtual key: qwen-latest, openai/gpt-oss-20b
# provider=echo  -> adaptador deterministico offline (sem rede, para testes)
# -----------------------------------------------------------------------------
LUKATO_LLM__PROVIDER=openai_compatible    # openai_compatible | echo
LUKATO_LLM__BASE_URL=https://hub-gpus-lab.usto.re/v1
LUKATO_LLM__API_KEY=                      # <<< SEGREDO: sk-... (cofre corporativo)
LUKATO_LLM__MODEL=qwen-latest
LUKATO_LLM__FALLBACK_MODEL=openai/gpt-oss-20b
LUKATO_LLM__TEMPERATURE=0.2
LUKATO_LLM__MAX_TOKENS=2048
LUKATO_LLM__TIMEOUT=60
LUKATO_LLM__MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Embeddings — Qwen3-Embedding-0.6B (colecao pgvector "agente_evidence")
#
# ATENCAO: diferente do LLM, embeddings NAO degradam sozinhos. Um embedding ruim
# fica GRAVADO: hashing e Qwen3 produzem vetores de 1024 dimensoes em espacos
# semanticos distintos, e misturar os dois na mesma colecao quebra a busca em
# silencio, para sempre. Com provider=qwen, hub fora do ar e ERRO, nao degradacao.
#
# Em desenvolvimento e testes SEM acesso a rede corporativa, peca hashing
# explicitamente:  LUKATO_EMBEDDING__PROVIDER=hashing
# e use uma colecao propria (ex.: agente_evidence_dev) para nao contaminar a de producao.
#
# Trocar DIMENSIONS tambem exige re-embeddar a colecao inteira.
# -----------------------------------------------------------------------------
LUKATO_EMBEDDING__PROVIDER=qwen           # qwen | hashing
LUKATO_EMBEDDING__BASE_URL=https://hub-gpus.claro.com.br/embed06b/v1
LUKATO_EMBEDDING__API_KEY=                # <<< SEGREDO (se o endpoint exigir)
LUKATO_EMBEDDING__MODEL=Qwen/Qwen3-Embedding-0.6B
LUKATO_EMBEDDING__DIMENSIONS=1024
LUKATO_EMBEDDING__BATCH_SIZE=32
LUKATO_EMBEDDING__COLLECTION=agente_evidence

# -----------------------------------------------------------------------------
# Guardrails — a trinca entrada -> system prompt -> saida e parametrizavel
# por modulo; estes valores sao apenas os limites globais.
# -----------------------------------------------------------------------------
LUKATO_GUARDRAILS__ENABLED=true
LUKATO_GUARDRAILS__FAIL_OPEN=false
LUKATO_GUARDRAILS__REDACTION_TOKEN=[REDIGIDO]
LUKATO_GUARDRAILS__MAX_INPUT_CHARS=32000
LUKATO_GUARDRAILS__MAX_OUTPUT_CHARS=32000

# -----------------------------------------------------------------------------
# Observabilidade — Langfuse
# -----------------------------------------------------------------------------
LUKATO_OBSERVABILITY__LANGFUSE_ENABLED=false
LUKATO_OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com
LUKATO_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=    # <<< SEGREDO pk-lf-...
LUKATO_OBSERVABILITY__LANGFUSE_SECRET_KEY=    # <<< SEGREDO sk-lf-...
LUKATO_OBSERVABILITY__LOG_LEVEL=INFO
LUKATO_OBSERVABILITY__LOG_JSON=false
LUKATO_OBSERVABILITY__METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Seguranca
# Em producao: AUTH_ENABLED=true e JWT_SECRET forte (openssl rand -hex 32).
# -----------------------------------------------------------------------------
LUKATO_SECURITY__AUTH_ENABLED=false
LUKATO_SECURITY__JWT_SECRET=troque-este-segredo-em-producao
LUKATO_SECURITY__JWT_ALGORITHM=HS256
LUKATO_SECURITY__JWT_EXPIRES_SECONDS=3600
LUKATO_SECURITY__API_KEY_HEADER=X-API-Key
LUKATO_SECURITY__CORS_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# FinOps
# -----------------------------------------------------------------------------
LUKATO_FINOPS__ENABLED=true
LUKATO_FINOPS__CURRENCY=USD
LUKATO_FINOPS__DEFAULT_INPUT_USD_PER_1K=0.0
LUKATO_FINOPS__DEFAULT_OUTPUT_USD_PER_1K=0.0

# -----------------------------------------------------------------------------
# AdWatch — deteccao de comerciais em video (pesos normativos da SPEC-0010)
# S = 0.40*lexical + 0.25*semantico + 0.15*ocr + 0.15*visual + 0.05*duracao
# -----------------------------------------------------------------------------
LUKATO_ADWATCH__WINDOW_SIZES=[15.0,30.0,60.0]
LUKATO_ADWATCH__WINDOW_STRIDE=5.0
LUKATO_ADWATCH__WEIGHT_LEXICAL=0.40
LUKATO_ADWATCH__WEIGHT_SEMANTIC=0.25
LUKATO_ADWATCH__WEIGHT_OCR=0.15
LUKATO_ADWATCH__WEIGHT_VISUAL=0.15
LUKATO_ADWATCH__WEIGHT_DURATION=0.05
LUKATO_ADWATCH__ACCEPT_THRESHOLD=0.90
LUKATO_ADWATCH__REVIEW_THRESHOLD=0.60
LUKATO_ADWATCH__TOP_K_RETRIEVAL=10
LUKATO_ADWATCH__TOP_K_RERANK=3
LUKATO_ADWATCH__WORKDIR=./var/adwatch
